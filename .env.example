# cp .env.example .env && chmod 600 .env, then fill in the values below.

# --- Grafana ---------------------------------------------------------------
# Your Grafana base URL, e.g. https://grafana.example.com/
GRAFANA_URL=
# Service account token (Grafana > Administration > Service accounts, role Viewer
# is enough for the read-only tools).
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# --- Who can call the MCP server -----------------------------------------------
# none   : local use, no client token. Requires BIND_IP=127.0.0.1 (or ::1).
# static : per-client tokens, managed with ./start.sh add-client <name>.
# authz  : every request checked by an external auth service at AUTHZ_URL
#          (2xx allow / 401 / 403, optional X-MCP-Gateway-User header).
AUTH_MODE=none
AUTHZ_URL=

# --- Listen address --------------------------------------------------------
# 127.0.0.1 for local use. To share, use an address only your team can reach,
# e.g. a Tailscale/VPN IP (`tailscale ip -4`). Avoid 0.0.0.0 on hosts with
# public or untrusted interfaces.
BIND_IP=127.0.0.1
BIND_PORT=18090

# --- Images ----------------------------------------------------------------
MCP_GRAFANA_IMAGE=grafana/mcp-grafana:1.6.3
NGINX_IMAGE=nginx:1.29-alpine

# Generated by ./start.sh prepare. Leave empty.
MCP_GRAFANA_SERVER_TOKEN=
